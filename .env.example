# Prvi vlasnik panela (/admin). Koristi se samo dok u bazi nema nijednog korisnika: pri prvoj
# prijavi od ovoga nastaje nalog vlasnika, a posle se korisnici i lozinke vode u panelu
# (Korisnici, Moj nalog). Zaključani ste? npm run admin:user -- <ime> <nova-lozinka>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=promeni-me

# Kod za prvo pokretanje panela na serveru (npm run start, Docker). Prazno: napravi se sam i
# ispiše u dnevnik servera. Uz npm run dev se ne traži.
# SETUP_CODE=

# Ključ kojim su u bazi šifrovane SMTP lozinka i Google tajna. Prazno: pravi se sam, u
# storage/data.key (DATA_KEY_FILE ga premešta). Čuvajte ga odvojeno od kopije baze.
# DATA_KEY=

# Tajna za potpisivanje žetona (pregled izmena na sajtu). Nije obavezna: bez nje server
# napravi svoju i čuva je u bazi.
# APP_SECRET=

# MySQL ili MariaDB (MAMP: port 8889, root/root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopcrm
# Baze u oblaku: DB_SSL=true, ili DB_SSL_CA sa celim tekstom CA sertifikata
# DB_SSL=true
# DB_SSL_CA=

# Javna adresa CRM-a, npr. https://crm.mojsajt.rs — za adrese slika u API-ju i za linkove u
# emailu (nova lozinka, korpa, novosti) i potvrdu plaćanja karticom. Umesto nje može adresa sajta
# u Podešavanjima. Bez obe se linkovi ne šalju (osim na localhost-u): adresa iz zahteva se za njih
# ne uzima, jer je posetilac može podmetnuti.
# PUBLIC_URL=

# Koliko proxy-ja (nginx, Cloudflare, load balancer) stoji ispred aplikacije; po tome se iz
# zaglavlja X-Forwarded-For čita adresa posetioca za ograničenje pokušaja. Podrazumevano 1.
# TRUSTED_PROXIES=1

# Folder sa ubačenim slikama (podrazumevano ./storage/uploads)
# UPLOADS_DIR=
# Putanja do mysqldump-a za `npm run backup`, ako nije u PATH-u
# MYSQLDUMP_PATH=

# Probni procesor kartica, za proveru toka plaćanja bez banke. Ne naplaćuje ništa;
# ne uključivati na pravoj prodavnici.
# CARD_TEST_PROVIDER=1

# Ključ za /api/v1/cron (podsetnici za napuštene korpe) na hostingu gde server ne radi stalno.
# CRON_SECRET=
