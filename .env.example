# Prvi vlasnik panela (/admin). Koristi se samo dok u bazi nema nijednog korisnika: pri prvoj
# prijavi od ovoga nastaje nalog vlasnika, a posle se korisnici i lozinke vode u panelu
# (Korisnici, Moj nalog). Zaključani ste? npm run admin:user -- <ime> <nova-lozinka>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=promeni-me

# Tajna za potpisivanje žetona (pregled izmena na sajtu). Nije obavezna: bez nje server
# napravi svoju i čuva je u bazi.
# APP_SECRET=

# MySQL ili MariaDB (MAMP: port 8889, root/root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopcrm
# Baze u oblaku: DB_SSL=true, ili DB_SSL_CA sa celim tekstom CA sertifikata
# DB_SSL=true
# DB_SSL_CA=

# Javna adresa CRM-a, npr. https://crm.mojsajt.rs — koristi se za adrese slika u API-ju.
# Bez nje se uzima adresa sa koje je stigao zahtev.
# PUBLIC_URL=

# Folder sa ubačenim slikama (podrazumevano ./storage/uploads)
# UPLOADS_DIR=
# Putanja do mysqldump-a za `npm run backup`, ako nije u PATH-u
# MYSQLDUMP_PATH=

# Probni procesor kartica, za proveru toka plaćanja bez banke. Ne naplaćuje ništa;
# ne uključivati na pravoj prodavnici.
# CARD_TEST_PROVIDER=1

# Ključ za /api/v1/cron (podsetnici za napuštene korpe) na hostingu gde server ne radi stalno.
# CRON_SECRET=
