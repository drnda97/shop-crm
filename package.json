{
  "name": "shopcrm",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/alias.mjs scripts/seed-demo.mjs",
    "admin:user": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/alias.mjs scripts/admin-user.mjs",
    "images:optimize": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/alias.mjs scripts/optimize-images.mjs"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
